    "/api/v1/meters/{id}/readings": {
      "get": {
        "summary": "Get historical consumption and electrical readings",
        "tags": [
          "Meters",
          "Readings"
        ],
        "description": "Fetches normalized time-series readings (kWh, kVAh, voltage) for a specific meter, parsed into clean numbers and ISO timestamps.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Maximum readings to return"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Meter ID (e.g. J100000)"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meterId": {
                      "type": "string"
                    },
                    "readingCount": {
                      "type": "integer"
                    },
                    "readings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "timestamp": {
                            "type": "string",
                            "example": "23/06/2026 23:30"
                          },
                          "isoTimestamp": {
                            "type": "string",
                            "nullable": true,
                            "example": "2026-06-23T23:30:00Z"
                          },
                          "kwh": {
                            "type": "number",
                            "example": 48438.74
                          },
                          "kvah": {
                            "type": "number",
                            "example": 52313.84
                          },
                          "voltR": {
                            "type": "number",
                            "example": 226
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "error": {
                      "type": "string",
                      "example": "Not Found"
                    },
                    "message": {
                      "type": "string",
                      "example": "Meter J999999 not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
