    "/api/v1/transformers/{code}": {
      "get": {
        "summary": "Get transformer details and connected meters",
        "tags": [
          "Transformers"
        ],
        "description": "Returns specifications of a single distribution transformer along with all smart meters connected to it.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "code",
            "required": true,
            "description": "Transformer code (e.g. DT-001)"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "feederCode": {
                      "type": "string"
                    },
                    "capacityKva": {
                      "type": "number"
                    },
                    "connectedMetersCount": {
                      "type": "integer"
                    },
                    "meters": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "meterId": {
                            "type": "string"
                          },
                          "serialNo": {
                            "type": "string"
                          },
                          "phaseType": {
                            "type": "string"
                          },
                          "installStatus": {
                            "type": "string"
                          },
                          "make": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 404
                    },
                    "error": {
                      "type": "string",
                      "example": "Not Found"
                    },
                    "message": {
                      "type": "string",
                      "example": "Meter J999999 not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "summary": "Get reconstructed electrical network hierarchy",
        "tags": [
          "Network Hierarchy"
        ],
        "description": "Reconstructs the hierarchical structure of the electricity distribution grid: Zones -> Circles -> Divisions -> Subdivisions -> Substations -> Feeders -> DTs -> Meters.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "object",
                      "properties": {
                        "totalMeters": {
                          "type": "integer"
                        },
                        "totalTransformers": {
                          "type": "integer"
                        },
                        "lastHydratedAt": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "tree": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export": {
      "get": {
        "summary": "Export complete meter dataset with HMAC authorization",
        "tags": [
          "Bulk Export"
        ],
        "description": "Fetches the complete dataset using the upstream HMAC-SHA256 signed /portal/export route. Ideal for data pipelines and analytics integrations.",
        "parameters": [
          {
            "schema": {
              "type": "boolean",
              "default": false
            },
            "in": "query",
            "name": "fresh",
            "required": false,
            "description": "Force a live query to the upstream portal instead of returning cached export"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "example": "upstream-hmac-export"
                    },
                    "exportedAt": {
                      "type": "string"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
