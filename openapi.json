{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy — Urja Meter Ops API",
    "description": "Clean, documented REST API service bridging the Urja Meter Ops distribution metering portal. Provides programmatic access to smart meters, network hierarchy, DT topology, time-series energy consumption, and geospatial queries.",
    "version": "1.0.0",
    "contact": {
      "name": "Flock Energy Engineering Take-Home"
    }
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health and cache diagnostics",
        "tags": [
          "System"
        ],
        "description": "Reports service uptime, upstream portal session status, and cache hydration metrics.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "uptimeSeconds": {
                      "type": "number"
                    },
                    "upstream": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "authenticated": {
                          "type": "boolean"
                        },
                        "sessionExpiresAt": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "cache": {
                      "type": "object",
                      "properties": {
                        "metersCount": {
                          "type": "integer"
                        },
                        "transformersCount": {
                          "type": "integer"
                        },
                        "lastHydratedAt": {
                          "type": "string",
                          "nullable": true
                        },
                        "cacheTtlMs": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "summary": "List and filter smart meters",
        "tags": [
          "Meters"
        ],
        "description": "Retrieve a paginated list of smart meters with optional filtering by search text, make, phase, status, or transformer.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "q",
            "required": false,
            "description": "Search term for Meter ID or Serial Number"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "make",
            "required": false,
            "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Allied)"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "single",
                "three"
              ]
            },
            "in": "query",
            "name": "phase",
            "required": false,
            "description": "Filter by phase type"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "Installed",
                "Faulty",
                "Decommissioned"
              ]
            },
            "in": "query",
            "name": "status",
            "required": false,
            "description": "Filter by installation status"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "dtCode",
            "required": false,
            "description": "Filter by Distribution Transformer code (e.g. DT-001)"
          },
          {
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number"
          },
          {
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "meterId": {
                            "type": "string",
                            "example": "J100000"
                          },
                          "serialNo": {
                            "type": "string",
                            "example": "SE33962"
                          },
                          "make": {
                            "type": "string",
                            "example": "HPL"
                          },
                          "phaseType": {
                            "type": "string",
                            "example": "single"
                          },
                          "installStatus": {
                            "type": "string",
                            "example": "Installed"
                          },
                          "installType": {
                            "type": "string",
                            "example": "Whole Current"
                          },
                          "build": {
                            "type": "string",
                            "example": "legacy"
                          },
                          "dtCode": {
                            "type": "string",
                            "example": "DT-001"
                          },
                          "geo": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "latitude": {
                                "type": "number",
                                "example": 26.938961
                              },
                              "longitude": {
                                "type": "number",
                                "example": 75.830956
                              }
                            }
                          },
                          "hierarchy": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "zone": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              },
                              "circle": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              },
                              "division": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              },
                              "subdivision": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              },
                              "substation": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              },
                              "feeder": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              },
                              "dt": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "example": "Jaipur Zone 1"
                                  },
                                  "code": {
                                    "type": "string",
                                    "nullable": true,
                                    "example": "Z-01"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/nearby": {
      "get": {
        "summary": "Find meters near a geographic location",
        "tags": [
          "Meters",
          "Spatial Query"
        ],
        "description": "Search for meters located within a given radius (in km) from specified latitude and longitude coordinates.",
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "lat",
            "required": true,
            "description": "Latitude of center point"
          },
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "lng",
            "required": true,
            "description": "Longitude of center point"
          },
          {
            "schema": {
              "type": "number",
              "default": 5
            },
            "in": "query",
            "name": "radiusKm",
            "required": false,
            "description": "Search radius in kilometers"
          },
          {
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            },
            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
